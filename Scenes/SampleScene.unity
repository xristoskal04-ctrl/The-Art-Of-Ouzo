  m_text: "\u0395\u03AF\u03C3\u03B1\u03B9 \u03BC\u03AD\u03C3\u03B1 \u03C3\u03B5 \u03AD\u03BD\u03B1
    \u03C0\u03B1\u03C1\u03B1\u03B4\u03BF\u03C3\u03B9\u03B1\u03BA\u03CC \u03B1\u03C0\u03BF\u03C3\u03C4\u03B1\u03BA\u03C4\u03AE\u03C1\u03B9\u03BF
    \u03BF\u03CD\u03B6\u03BF\u03C5. \u03A0\u03C1\u03AD\u03C0\u03B5\u03B9 \u03BD\u03B1
    \u03BC\u03B1\u03B6\u03AD\u03C8\u03B5\u03B9\u03C2 2 \u03BC\u03C0\u03BF\u03C5\u03BA\u03AC\u03BB\u03B9\u03B1
    \u0391\u03BB\u03BA\u03CC\u03BF\u03BB, 1 \u03C3\u03B1\u03BA\u03BF\u03CD\u03BB\u03B1
    \u03BC\u03B5 \u03C3\u03C0\u03CC\u03C1\u03BF\u03C5\u03C2 \u03BA\u03B1\u03B9 3
    \u03AC\u03BD\u03B9\u03C3\u03BF\u03C5\u03C2.\n\u03A0\u03AC\u03C4\u03B1 space \u03B3\u03B9\u03B1
    \u03BD\u03B1 \u03C0\u03C1\u03BF\u03C7\u03C9\u03C1\u03AE\u03C3\u03B5\u03B9\u03C2."
